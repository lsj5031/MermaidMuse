# API Configuration
# For local dev: run Wrangler (`npm run dev:workers`) and point the UI at it
VITE_API_URL=http://localhost:8787

# Clerk Authentication (client-side)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe Configuration (client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# OpenAPI Compatible Endpoint (server-side - NOT exposed to the client)
# Works with OpenAI API, Groq, or any OpenAI-compatible endpoint
# Note: OPENAPI_MODEL and OPENAPI_BASE_URL are configured in wrangler.toml
OPENAPI_API_KEY=
