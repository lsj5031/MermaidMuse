# API Configuration
VITE_API_URL=http://localhost:3000

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe Configuration (client-side)
# Preferred:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Legacy fallback (still supported):
VITE_STRIPE_KEY=

# Pro feature mocking (client-side)
# Set to "true"/"1" to bypass the ProGate and show pro-only UI locally.
VITE_MOCK_PRO=false

# OpenAPI Compatible Endpoint (server-side - NOT exposed to the client)
# Works with OpenAI API, Groq, or any OpenAI-compatible endpoint
OPENAPI_API_KEY=
OPENAPI_MODEL=gpt-4o
OPENAPI_BASE_URL=https://api.openai.com/v1

# Legacy xAI support (still supported for backward compatibility)
# XAI_API_KEY=
# XAI_MODEL=grok-beta
# XAI_BASE_URL=https://api.x.ai/v1

# Environment
NODE_ENV=development
