# API Configuration
VITE_API_URL=http://localhost:3000

# Stripe Configuration (client-side)
# Preferred:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Legacy fallback (still supported):
VITE_STRIPE_KEY=

# Pro feature mocking (client-side)
# Set to "true"/"1" to bypass the ProGate and show pro-only UI locally.
VITE_MOCK_PRO=false

# xAI / Grok (server-side - NOT exposed to the client)
XAI_API_KEY=
XAI_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1

# Environment
NODE_ENV=development
